{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lbrodie11/gutter/schema/gutter.schema.json",
  "title": "gutter.json (schemaVersion 1)",
  "description": "Evidence model for one change. Additive fields and enum values keep schemaVersion 1; consumers must ignore unknown properties and tolerate unknown enum values (e.g. new checklist.kind values).",
  "type": "object",
  "required": ["schemaVersion", "tool", "change", "salience", "changes", "dependents", "forgotten", "tests", "checklist", "calibration", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "const": "gutter" }, "version": { "type": "string" } }
    },
    "change": {
      "type": "object",
      "required": ["base", "head", "title", "commits"],
      "properties": {
        "base": { "type": "string" },
        "head": { "type": "string" },
        "baseSha": { "type": "string" },
        "headSha": { "type": "string" },
        "title": { "type": "string", "description": "Untrusted text." },
        "intent": { "type": "string", "description": "Untrusted text, trimmed to 600 chars." },
        "commits": {
          "type": "array",
          "items": { "type": "object", "required": ["sha", "subject"], "properties": { "sha": { "type": "string" }, "subject": { "type": "string" } } }
        },
        "repoUrl": { "type": "string" },
        "prNumber": { "type": "integer" }
      }
    },
    "salience": {
      "type": "object",
      "required": ["level", "reasons"],
      "properties": {
        "level": { "enum": ["quiet", "brief", "full"], "description": "Consumers must tolerate unknown enum values." },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "changes": {
      "type": "object",
      "required": ["files", "modules", "totals"],
      "properties": {
        "files": { "type": "array", "items": { "$ref": "#/$defs/ChangedFile" } },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "files", "additions", "deletions"],
            "properties": { "name": { "type": "string" }, "files": { "type": "integer" }, "additions": { "type": "integer" }, "deletions": { "type": "integer" } }
          }
        },
        "totals": {
          "type": "object",
          "required": ["files", "additions", "deletions", "modules"],
          "properties": { "files": { "type": "integer" }, "additions": { "type": "integer" }, "deletions": { "type": "integer" }, "modules": { "type": "integer" } }
        }
      }
    },
    "dependents": {
      "type": "object",
      "required": ["analyzers", "entries", "unchecked", "coverage", "unresolved", "scannedFiles"],
      "properties": {
        "analyzers": { "type": "array", "items": { "type": "string" }, "description": "Which analyzers ran. With Repo Archaeology's import graph (GU-05): ra-import-graph plus the edge via kinds seen (relative, paths, workspace, exports, imports, go-package, python-module; may grow). Fallback: ts-js-relative-imports." },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "file", "deleted", "changedImporters", "untouchedImporters"],
            "properties": {
              "id": { "$ref": "#/$defs/EvidenceId" },
              "file": { "type": "string" },
              "deleted": { "type": "boolean" },
              "changedImporters": { "type": "array", "items": { "type": "string" } },
              "untouchedImporters": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "unchecked": { "type": "array", "items": { "type": "string" }, "description": "Changed files with no analyzer for their language. Never reported as 'no dependents'." },
        "coverage": { "enum": ["full", "partial"], "description": "'full' when all non-external imports were resolved; 'partial' when unresolved imports exist. Consumers must tolerate unknown enum values." },
        "unresolved": {
          "type": "object",
          "required": ["count", "samples"],
          "description": "Imports that could not be resolved to a repository file (<file> → <specifier>), with up to 5 sorted samples.",
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "samples": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
            "byReason": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }, "description": "GU-05, optional: counts by Repo Archaeology reasonCode (alias-unmatched, unknown-package, target-missing, not-exported, invalid-target, unsupported-config, ambiguous-package, unknown; may grow)." }
          }
        },
        "unresolvedAliases": { "type": "integer", "minimum": 0, "description": "Deprecated legacy v1 count normalized into unresolved.count." },
        "scannedFiles": { "type": "integer" }
      }
    },
    "forgotten": {
      "type": "object",
      "required": ["status", "items", "total", "families", "commitsAnalyzed", "warnings"],
      "properties": {
        "status": { "enum": ["analyzed", "insufficient-history", "unavailable"], "description": "Consumers must tolerate unknown enum values." },
        "presentation": { "enum": ["context"], "description": "GU-29, optional: 'context' means this co-change layer is history shown as context, never a prediction or a checklist source. Absent under legacyPredictions and in pre-GU-29 briefs. Consumers must tolerate unknown enum values." },
        "note": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/ForgottenItem" } },
        "total": { "type": "integer" },
        "families": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "why", "members", "changedMembers", "untouchedMembers"],
            "properties": {
              "id": { "$ref": "#/$defs/EvidenceId" },
              "label": { "type": "string" },
              "why": { "type": "string" },
              "members": { "type": "array", "items": { "type": "string" } },
              "changedMembers": { "type": "array", "items": { "type": "string" } },
              "untouchedMembers": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "commitsAnalyzed": { "type": "integer" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "status", "candidates"],
        "properties": {
          "id": { "$ref": "#/$defs/EvidenceId" },
          "source": { "type": "string" },
          "status": { "enum": ["test-changed", "test-untouched", "no-test-found"], "description": "Consumers must tolerate unknown enum values. Since GU-29 (default mode) a co-change test partner the naming conventions missed is added to candidates, so status can be test-untouched where naming alone found no test; the checklist is computed from the naming-only links." },
          "candidates": {
            "type": "array",
            "items": { "type": "object", "required": ["path", "changed"], "properties": { "path": { "type": "string" }, "changed": { "type": "boolean" } } }
          },
          "history": {
            "type": "object",
            "description": "GU-29, optional: co-change history pairing source with one of its test candidates. together and sourceCommits describe the pair cited by evidence[0] (the naming-convention test when it is a partner, else the strongest pair); later evidence ids are other test partners of the same source. A historical fact; it never affects checklist or salience. Absent under legacyPredictions.",
            "required": ["together", "sourceCommits", "evidence"],
            "properties": {
              "together": { "type": "integer", "minimum": 0, "description": "Commits of source that also changed the paired test." },
              "sourceCommits": { "type": "integer", "minimum": 0, "description": "Commits of source in the analyzed history." },
              "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/EvidenceId" }, "description": "Ids of forgotten items carrying the receipts; the first is the pair the counts describe." }
            }
          }
        }
      }
    },
    "checklist": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "kind", "question", "evidence", "priority"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["broken-import", "forgotten-companion", "family-drift", "untested-change", "wide-surface"], "description": "Consumers must tolerate unknown enum values. Since GU-29, forgotten-companion and family-drift are produced only under legacyPredictions; they stay in the enum for v1 readers." },
          "question": { "type": "string", "description": "A question or a plain statement of fact, never a verdict or a prediction. Paths appear in backticks." },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/EvidenceId" }, "description": "Must resolve to ids in dependents, forgotten, families or tests." },
          "priority": { "type": "integer" }
        }
      }
    },
    "calibration": {
      "type": "object",
      "required": ["status", "note"],
      "properties": {
        "status": { "enum": ["measured", "thin", "unavailable", "skipped"], "description": "Consumers must tolerate unknown enum values." },
        "note": { "type": "string" },
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "hitRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "lift": { "type": "number", "minimum": 0 },
        "testCommits": { "type": "integer" },
        "fired": { "type": "integer" },
        "window": { "type": "object", "required": ["from", "to"], "properties": { "from": { "type": "string" }, "to": { "type": "string" } } }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["generatedAt", "engines", "deterministic"],
      "properties": {
        "generatedAt": { "type": "string", "format": "date-time" },
        "engines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "mode": { "enum": ["library", "subprocess", "npx"], "description": "GU-05, optional: how Repo Archaeology ran. Consumers must tolerate unknown enum values." },
              "features": { "type": "array", "items": { "type": "string" }, "description": "GU-05, optional: optional Repo Archaeology fields detected in this run (interval, origin, originShare, trackRecord, followUps, owners, importGraph; may grow)." }
            }
          }
        },
        "deterministic": { "const": true }
      }
    }
  },
  "$defs": {
    "EvidenceId": { "type": "string", "pattern": "^(deps|forgotten|family|tests):" },
    "ChangedFile": {
      "type": "object",
      "required": ["path", "status", "additions", "deletions", "binary", "module", "isTest", "language"],
      "properties": {
        "path": { "type": "string" },
        "oldPath": { "type": "string" },
        "status": { "enum": ["added", "modified", "deleted", "renamed"], "description": "Consumers must tolerate unknown enum values." },
        "additions": { "type": "integer" },
        "deletions": { "type": "integer" },
        "binary": { "type": "boolean" },
        "module": { "type": "string" },
        "isTest": { "type": "boolean" },
        "language": { "type": ["string", "null"] }
      }
    },
    "ForgottenItem": {
      "type": "object",
      "required": ["id", "changed", "file", "relationship", "why", "shared", "changedTotal", "confidence", "interval", "evidence", "automationShare", "alsoLinkedFrom"],
      "properties": {
        "id": { "$ref": "#/$defs/EvidenceId" },
        "changed": { "type": "string" },
        "file": { "type": "string" },
        "relationship": { "enum": ["ghost", "unknown", "indirect", "direct", "test"], "description": "Consumers must tolerate unknown enum values." },
        "why": { "type": "string" },
        "shared": { "type": "integer" },
        "changedTotal": { "type": "integer" },
        "confidence": { "type": "number" },
        "interval": { "type": "object", "required": ["low", "high"], "properties": { "low": { "type": "number" }, "high": { "type": "number" } } },
        "lastTogether": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sha", "date", "author", "subject", "automated"],
            "properties": { "sha": { "type": "string" }, "date": { "type": "string" }, "author": { "type": "string" }, "subject": { "type": "string" }, "automated": { "type": "boolean" }, "origin": { "enum": ["human", "agent", "bot"], "description": "GU-05, optional: Repo Archaeology commit origin. Consumers must tolerate unknown enum values." } }
          }
        },
        "automationShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "alsoLinkedFrom": { "type": "array", "items": { "type": "string" } },
        "originShare": {
          "type": "object",
          "required": ["human", "agent", "bot"],
          "description": "GU-05, optional: Repo Archaeology share of shared commits by origin.",
          "properties": { "human": { "type": "number", "minimum": 0, "maximum": 1 }, "agent": { "type": "number", "minimum": 0, "maximum": 1 }, "bot": { "type": "number", "minimum": 0, "maximum": 1 } }
        }
      }
    }
  }
}
